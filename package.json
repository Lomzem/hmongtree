{
	"name": "hmongtree",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && lefthook install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && bun run lint:styles",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"lint:eslint": "eslint .",
		"check:secrets": "gitleaks git --staged --redact=100 --no-banner",
		"verify": "bun run check && bun run lint && bun run test && bun run build",
		"convex:dev": "convex dev",
		"convex:deploy": "convex deploy",
		"lint:styles": "bun tooling/check-styles.ts",
		"convex:codegen": "convex codegen"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.72.0",
		"@shadcn/lint": "^0.2.5",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"convex-test": "^0.0.71",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"lefthook": "^2.2.2",
		"postcss": "^8.5.32",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.10.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"convex": "^1.50.0",
		"convex-svelte": "^0.15.1",
		"effect": "^4.1.4",
		"svelte-clerk": "^1.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tw-animate-css": "^1.4.0"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.17",
		"bun": ">=1.4.4"
	}
}
